# Environment for tailscale-web.service.
#
# WEB_LISTEN: bind address for the tailscale web management UI.
#   0.0.0.0:8088 — LAN + tailnet + CF Tunnel all reachable.
#   100.x:5252   — tailscale default; tailnet only. Set this if you want to
#                  hide the UI from LAN peers (but then CF Tunnel breaks
#                  unless you point it at the tailnet IP).
# Any client that reaches this port can control tailscale on this host
# (connect/disconnect, exit node, share). Put CF Access in front of the
# public URL if that is a concern.
WEB_LISTEN=0.0.0.0:8088

# SERVE_TARGET: not read by tailscale-web.service directly, but documented
# here so operators know what `tailscale serve` was configured to proxy.
# The current reference machine has:
#   sudo tailscale serve --bg --https=443 http://127.0.0.1:30142
# which exposes pi-agent over tailnet HTTPS at https://<hostname>.<tailnet>/.
SERVE_TARGET=http://127.0.0.1:30142
